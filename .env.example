# Example environment variables for the Community Management System (cms)
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# The app loads `.env` in non-production environments and validates all
# variables at startup using `src/env.ts` (Zod). If validation fails the
# server will log the validation errors and exit.
#
# Keep secrets out of source control (do NOT commit your real `.env`).

# General
# NODE_ENV should be one of: development, production, test
NODE_ENV=development

# Fully qualified app URL used to build links (magic link, redirects)
# Defaults to http://localhost:5173 in development if not set.
APP_URL=http://localhost:5173

# Friendly application name (used in email templates)
APP_NAME=My Community App

# UI language (spec 4.8): en (default) or de. Applied at build time: rebuild after changing it.
# Keys a locale lacks fall back to English.
SITE_LOCALE=en

# Security
# MAGIC_LINK_SECRET (OPTIONAL) - when set, magic link tokens are HMAC-SHA256 signed.
# Recommended in production. Use a strong, high-entropy secret.
MAGIC_LINK_SECRET=replace-with-a-strong-secret

# SMTP (email)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# AWS S3 (file storage)
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-bucket-name
S3_UPLOAD_PATH=uploads

# Stripe (payments, spec 4.7). Leave both unset to disable payments (free flows only).
# Webhook endpoint: <APP_URL>/api/payments/webhook/stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# PAYMENTS_CURRENCY=eur
# PAYMENTS_CHECKOUT_EXPIRY_MINUTES=60
# Optional: Use a local stripe-mock instance (e.g. run `npm run start:stripe-mock` or via docker-compose)
# STRIPE_API_BASE_URL=http://localhost:12111

# Telegram (notifications)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_CHANNEL_ID=-1001234567890
# Scope tree: kinds of the groups below the root, comma-separated (default: region,chapter)
# SCOPE_KINDS=region,chapter
# Social web module (RSS at /feed.xml, pull-only ActivityPoll account <account>@<APP_URL host>)
# SOCIAL_WEB_ACCOUNT=news
# SOCIAL_WEB_SUMMARY=News from our community
# SOCIAL_WEB_UPDATE_INTERVAL=P1D
# SOCIAL_WEB_ICON=/favicon.svg
