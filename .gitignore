# Kamal
.kamal/secrets

# SQLite databases (dev, e2e, promo, CI) with their WAL files. Ignored files are also
# skipped by Tailwind's source scan: if the dev server process opens and closes a database
# file, it drops its own SQLite locks on it (POSIX), and another process can then reset the
# WAL index under it (SIGBUS in walFindFrame).
*.db
*.db-shm
*.db-wal
# Recorded promo-video output (regenerated by `npm run promo-videos`; final
# .mp4s get copied into promo-site's public/videos/ by hand)
scripts/promo-videos/output/
\n# Private event photos\nprivate/events/

# Playwright
tmp/
test-results/
playwright-report/
.playwright-cli
playwright/.auth/*.json
# Obsidian (only the shared vault settings are committed)
.obsidian/*
!.obsidian/app.json
!.obsidian/graph.json
