# syntax=docker/dockerfile:1
#
# Template Dockerfile for a downstream "theme fork" — a thin repo that owns
# only its own theme/ directory and wants to ship a themed image without
# rebuilding all of core. Copy this file into the fork repo (it is not run
# from core's own checkout) and fill in the placeholders below. See
# docs/theme-development.md ("Drop-in theme overlay") for the full
# mechanism this relies on, including its known limitations.
#
# This file is owned by the fork repo and committed there, same as any other
# Dockerfile pinning a base image tag — there's no need to pass the core
# commit/image in as a build arg. When core cuts a new base image, bump the
# `--branch` line below and the runtime `FROM` tag together in one commit;
# they must reference the exact same core commit (see "Requirements" below).
#
# Requirements:
#   - The git clone's --branch and the runtime FROM's tag must point at the
#     exact same core commit. Both builds must compile identical core source
#     — only theme/ may differ — or the deterministic chunk names and
#     manifest entries this mechanism depends on won't line up between them.
#   - This repo provides its own theme/ directory at its root, laid out the
#     same way as core's (see theme/README.md), which is overlaid onto
#     core's before building.
#
# Usage:
#   docker build -f Dockerfile.theme-overlay -t my-chapter-site .

# ---- Theme build stage: compile only theme/ against pinned core source --
FROM node:24-bookworm-slim AS theme-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pin to the exact core commit/tag the runtime FROM below was built from.
RUN git clone --depth 1 --branch "<commit-or-tag>" \
    https://github.com/<org>/cms.git .

RUN npm ci

# Overlay this fork's own theme/ directory over core's default one, then
# build. Only theme/ differs from the build that produced the runtime base.
COPY theme ./theme
RUN npm run build.client && npm run build.server \
  && npm run theme:extract -- --out=theme-artifact

# ---- Runtime stage: overlay the extracted theme onto the published base --
# Must be the exact same commit/tag as the git clone above.
FROM ghcr.io/<org>/cms:<same-commit-or-tag> AS runtime

WORKDIR /app

COPY --from=theme-build /app/theme-artifact ./theme-artifact
# theme/static/ (favicon, manifest.json, fonts, logo) is copied byte-for-byte
# by Vite's publicDir at build time — no content hashing, so unlike the
# JS/CSS build output there's nothing to extract/merge; it's overlaid
# directly onto the base's dist/.
COPY --from=theme-build /app/theme/static/. ./dist/

# node_modules and scripts/theme-swap come from the base image (see
# Dockerfile) — reused as-is rather than reinstalled.
RUN node_modules/.bin/tsx scripts/theme-swap/merge.ts --theme=theme-artifact \
  && rm -rf theme-artifact

# ENTRYPOINT, EXPOSE, and the litestream/migration setup are inherited from
# the base image unchanged.
