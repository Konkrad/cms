{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!drizzle", "!src/components/editor/koenig-lexical.css"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"domains": {
			"qwik": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["theme/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["~/services/**", "~/core/*/*.service"],
										"message": "theme must not import core services directly — add or use a headless composable in ~/components/builder/blocks/* instead."
									},
									{
										"group": [
											"~/db/**",
											"~/core/db/**",
											"~/core/*/schema/**",
											"~/core/*/schema"
										],
										"message": "theme must not import core db/schema directly — use a type from ~/contracts/* instead."
									},
									{
										"group": ["~/core/auth/**"],
										"message": "theme must not import server-auth directly — auth checks belong in a core-owned composable or route loader/action."
									},
									{
										"group": ["~/env"],
										"message": "theme must not import ~/env directly."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["modules/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["~/services/**"],
										"message": "modules must not import core services — use ~/core-api or the module's own service."
									},
									{
										"group": ["~/db/**"],
										"message": "modules must not import core db/schema — use ~/core-api."
									},
									{
										"group": ["~/utils/**"],
										"message": "modules must not import core utils — re-export what is needed from ~/core-api."
									},
									{
										"group": ["~/env"],
										"message": "modules must not import ~/env directly."
									},
									{
										"group": ["~/components/**"],
										"message": "modules must not import core components — use ~/ui."
									},
									{
										"group": ["~/core/**"],
										"message": "modules may only import ~/core-api, ~/ui, ~/contracts/* and ~theme/*."
									},
									{
										"group": ["~modules/**"],
										"message": "modules never import another module; import files of your own folder via relative paths."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["theme/routes/profile/QrTicketWall/QrTicketWall.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		}
	]
}
