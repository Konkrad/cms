{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!drizzle",
			"!src/core/content/editor/koenig-lexical.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"domains": {
			"qwik": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["theme/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["~/core/*/*.service"],
										"message": "theme must not import core services directly — add or use a headless composable in ~/core/content/builder/blocks/* instead."
									},
									{
										"group": [
											"~/core",
											"~/core/schema",
											"~/core/db/**",
											"~/core/*/schema/**",
											"~/core/*/schema"
										],
										"message": "theme must not import core db/schema (or the module API root ~/core) directly — use a type from ~/contracts/* instead."
									},
									{
										"group": ["~/core/auth/**"],
										"message": "theme must not import server-auth directly — auth checks belong in a core-owned composable or route loader/action."
									},
									{
										"group": ["~/env"],
										"message": "theme must not import ~/env directly."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["modules/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["~/core/*/**"],
										"message": "modules may only import the root files of src/core (~/core, ~/core/ui, ~/core/schema, ~/core/seo, ~/core/setup-actions), never an area folder (~/core/<area>/**)."
									},
									{
										"group": ["~/core-api", "~/core-api/**", "~/ui", "~/ui/**"],
										"message": "~/core-api and ~/ui were replaced by ~/core and ~/core/ui."
									},
									{
										"group": ["~/env"],
										"message": "modules must not import ~/env directly — add a getter to ~/core instead."
									},
									{
										"group": ["~/components/**"],
										"message": "modules must not import core components — use ~/core/ui."
									},
									{
										"group": ["~modules/**"],
										"message": "modules never import another module; import files of your own folder via relative paths."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["theme/routes/profile/QrTicketWall/QrTicketWall.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		}
	]
}
