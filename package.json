{
  "name": "cms",
  "description": "Demo app with sample routes",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "trustedDependencies-annotation": "Needed for bun to allow running install scripts",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr --host 0.0.0.0",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "build": "qwik build",
    "build.types": "tsc --noEmit",
    "preview": "qwik build preview && vite preview --host 0.0.0.0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed.ts --fresh",
    "email:dev": "email dev --dir=src/emails",
    "biome": "biome check . --write",
    "test": "playwright test",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@builder.io/qwik": "^1.7.3",
    "@builder.io/qwik-city": "^1.7.3",
    "@builder.io/qwik-react": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@react-email/preview-server": "5.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/flatpickr": "^3.0.2",
    "@types/node": "^20.12.7",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.4.22",
    "drizzle-kit": "^0.31.8",
    "mailpit-api": "^1.7.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "react-email": "5.1.0",
    "testcontainers": "^11.13.0",
    "typescript": "5.4.5",
    "undici": "*",
    "vite": "^5.2.10",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@blocknote/core": "^0.45.0",
    "@blocknote/mantine": "^0.45.0",
    "@blocknote/react": "^0.45.0",
    "@react-email/components": "1.0.2",
    "@react-email/render": "2.0.0",
    "@types/d3": "^7.4.3",
    "@types/d3-geo": "^3.1.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/topojson-client": "^3.1.5",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.0",
    "@uppy/xhr-upload": "^5.1.1",
    "altcha": "^2.3.0",
    "altcha-lib": "^1.4.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.5.0",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "flatpickr": "^4.6.13",
    "fuse.js": "^7.1.0",
    "html5-qrcode": "^2.3.8",
