    "@qwik.dev/react": "^2.0.0-beta.38",
    "@qwik.dev/router": "^2.0.0-beta.38",
    "@react-email/preview-server": "^5.2.11",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/flatpickr": "^3.0.2",
    "@types/node": "^20.19.41",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/sharp": "^0.31.1",
    "drizzle-kit": "^1.0.0-rc.2-e38a2ba",
    "mailpit-api": "^1.7.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "react-email": "^6.1.3",
    "testcontainers": "^11.13.0",
    "tsx": "4.21.0",
