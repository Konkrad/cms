          "choices": [
            { "value": "classmate",      "text": "Through a classmate or colleague" },
            { "value": "professor",      "text": "Professor or staff recommendation" },
            { "value": "uni_email",      "text": "University notice board or email" },
            { "value": "social_media",   "text": "Social media" },
            { "value": "event",          "text": "University fair or community event" },
            { "value": "other",          "text": "Other" }
