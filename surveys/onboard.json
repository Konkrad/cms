          "choices": [
            { "value": "year_1",       "text": "1st year" },
            { "value": "year_2",       "text": "2nd year" },
            { "value": "year_3",       "text": "3rd year" },
            { "value": "year_4",       "text": "4th year" },
            { "value": "year_5_plus",  "text": "5th year or above" },
