          "isRequired": true,
          "choices": [
            { "value": "science",         "text": "Faculty of Science" },
            { "value": "engineering",     "text": "Faculty of Engineering & Technology" },
            { "value": "arts",            "text": "Faculty of Arts & Humanities" },
            { "value": "social_sciences", "text": "Faculty of Social Sciences & Business" },
