{
  "pages": [
    {
      "name": "academic_info",
      "title": "Your Academic Background",
      "elements": [
        {
          "type": "radiogroup",
          "name": "status",
          "title": "What is your current status?",
          "isRequired": true,
          "choices": [
            { "value": "current_student", "text": "Current student" },
            { "value": "graduate",        "text": "Graduate / Alumnus" },
            { "value": "staff",           "text": "Academic staff or researcher" },
            { "value": "other",           "text": "Other" }
          ]
        },
        {
          "type": "dropdown",
          "name": "faculty",
